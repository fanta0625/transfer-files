import { Button, ComboBox, CheckBox, LineEdit, ProgressIndicator, ListView, ScrollView, TextEdit } from "std-widgets.slint";

export struct RemoteTabRow { title: string, busy: bool, attention: bool }

export struct HopRow { host: string, user: string, port: string, system: int, identity: string }

export struct FileRow {
    name: string,
    kind: string,
    size: string,
    modified: string,
    directory: bool,
    selected: bool,
}

component FilePane inherits Rectangle {
    in property <string> heading;
    in property <string> subtitle;
    in-out property <string> path;
    in property <[FileRow]> rows;
    in property <bool> active;
    in property <bool> loading;
    in property <bool> busy;
    in property <bool> remote;
    in property <bool> transfer-enabled: true;
    in property <int> revision;
    in property <string> summary;
    callback navigate(string);
    callback parent-directory();
    callback refresh();
    callback toggle(int);
    callback open(int);
    callback select-all();
    callback clear-selection();
    callback activate();
    pure callback make-payload(int, int) -> data-transfer;
    callback accept-drop(DropEvent) -> DragAction;
    callback receive-drop(DropEvent);

    background: #ffffff;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? #178477 : #dce2e7;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text { text: root.heading; color: #182d38; font-size: 18px; font-weight: 700; }
            Button { text: root.active ? "外部拖入目标 ✓" : "设为外部拖入目标"; visible: root.transfer-enabled; enabled: !root.busy; clicked => { root.activate(); } }
        }
        Text { text: root.subtitle; color: #667782; font-size: 12px; }
        HorizontalLayout {
            spacing: 6px;
            Button { text: "上级"; enabled: !root.loading; clicked => { root.parent-directory(); } }
            path-input := LineEdit {
                text <=> root.path;
                enabled: !root.loading;
                accepted => { root.navigate(self.text); }
            }
            Button { text: "前往"; enabled: !root.loading; clicked => { root.navigate(root.path); } }
            Button { text: "刷新"; enabled: !root.loading; clicked => { root.refresh(); } }
        }
        HorizontalLayout {
            spacing: 6px;
            Button { text: "全选"; enabled: !root.loading; clicked => { root.select-all(); } }
            Button { text: "清空选择"; clicked => { root.clear-selection(); } }
            Text { text: root.loading ? "正在读取目录…" : root.summary; color: #667782; horizontal-alignment: right; }
        }
        Rectangle {
            background: #f1f5f6;
            height: 28px;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                Text { text: root.transfer-enabled ? "名称（双击打开目录，勾选多项后拖拽）" : "名称（双击打开目录）"; color: #526570; font-size: 12px; }
                Text { text: "大小"; width: 82px; color: #526570; horizontal-alignment: right; font-size: 12px; }
            }
        }
        // Empty space remains a valid drop target; children provide row interaction.
        DropArea {
            can-drop(event) => { return root.accept-drop(event); }
            dropped(event) => { root.receive-drop(event); return DragAction.copy; }
            Rectangle {
                border-width: parent.has-drag ? 2px : 0px;
                border-color: #178477;
                background: parent.has-drag ? #edf9f5 : #ffffff;
                ListView {
                    content-width: self.visible-width;
                        for row[index] in root.rows : DragArea {
                            height: 42px;
                            enabled: !root.busy && !root.loading;
                            allow-copy: root.transfer-enabled && !root.remote;
                            data: root.make-payload(index, root.revision);
                            Rectangle {
                                background: row.selected ? #dff2ec : (index / 2 == floor(index / 2) ? #ffffff : #f8fafb);
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 10px; spacing: 8px;
                                    CheckBox { checked: row.selected; toggled => { root.toggle(index); } }
                                    Text { text: row.kind; width: 40px; color: #178477; font-size: 11px; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        VerticalLayout {
                                            spacing: 0px;
                                            Text { text: row.name; vertical-alignment: center; overflow: elide; color: #233843; }
                                            Text { text: row.modified; color: #667782; font-size: 10px; }
                                        }
                                        row-touch := TouchArea {
                                            clicked => { root.toggle(index); }
                                            double-clicked => { root.open(index); }
                                        }
                                    }
                                    Text { text: row.size; width: 82px; horizontal-alignment: right; vertical-alignment: center; color: #667782; font-size: 12px; }
                                }
                            }
                        }
                }
            }
        }
        Text { text: root.transfer-enabled ? "拖入始终复制到本栏当前目录；不以悬停行作为目标" : (root.remote ? "目录快照 · 双击文件夹会重新连接读取" : "本地目录"); color: #667782; font-size: 11px; }
    }
}

export component AppWindow inherits Window {
    title: "Transfer Files · 双栏文件传输";
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 920px;
    min-height: 620px;
    background: #edf1f3;
    in property <[RemoteTabRow]> tabs;
    in property <int> selected-tab;
    callback select-tab(int);
    callback add-tab();
    callback close-tab(int);
    in-out property <string> setting-tab-name;
    in property <[FileRow]> left-rows;
    in property <[FileRow]> right-rows;
    in property <string> left-path;
    in property <string> right-path;
    in property <string> left-summary;
    in property <string> right-summary;
    in property <bool> left-loading;
    in property <bool> right-loading;
    in property <int> active-pane;
    in property <int> revision;
    in property <bool> busy;
    in property <bool> right-remote;
    in property <bool> remote-reading;
    in property <string> remote-snapshot;
    in property <bool> auth-visible;
    in property <bool> auth-host-key;
    in property <string> auth-title;
    in property <string> auth-detail;
    in-out property <string> auth-secret;
    callback auth-submit();
    callback auth-cancel();
    in property <float> progress;
    in property <string> status: "准备就绪";
    in property <string> detail;
    in property <string> history;
    in-out property <int> setting-target-system: 1;
    in-out property <string> setting-target-identity;
    in-out property <int> setting-cache-policy;
    in-out property <string> setting-route;
    in-out property <[HopRow]> setting-hops;
    callback change-hop(int, int);
    in property <string> remote-label;
    in-out property <string> setting-jump-host;
    in-out property <string> setting-jump-port;
    in-out property <string> setting-jump-user;
    in-out property <string> setting-windows-host;
    in-out property <string> setting-windows-port;
    in-out property <string> setting-windows-user;
    in-out property <string> setting-windows-root;
    in property <bool> settings-visible;
    in property <string> settings-error;
    callback navigate(int, string);
    callback parent-directory(int);
    callback refresh(int);
    callback toggle(int, int);
    callback open(int, int);
    callback select-all(int);
    callback clear-selection(int);
    callback activate(int);
    pure callback make-payload(int, int, int) -> data-transfer;
    callback accept-drop(int, DropEvent) -> DragAction;
    callback receive-drop(int, DropEvent);
    callback copy-selected(int);
    callback cancel();
    callback show-settings();
    callback save-settings(string, string, string, string, string, string, string, string);
    callback cancel-settings();

    // Used by the X11 native file-drop adapter; coordinates are logical pixels.
    public pure function pane-at(x: float, y: float) -> int {
        if (x >= left-pane.absolute-position.x / 1px && x < (left-pane.absolute-position.x + left-pane.width) / 1px
            && y >= left-pane.absolute-position.y / 1px && y < (left-pane.absolute-position.y + left-pane.height) / 1px) { return 0; }
        if (x >= right-pane.absolute-position.x / 1px && x < (right-pane.absolute-position.x + right-pane.width) / 1px
            && y >= right-pane.absolute-position.y / 1px && y < (right-pane.absolute-position.y + right-pane.height) / 1px) { return 1; }
        return -1;
    }

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        HorizontalLayout {
            Text { text: "TRANSFER FILES"; color: #173b3d; font-size: 23px; font-weight: 800; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: root.remote-reading ? "读取中…" : "读取远程目录"; enabled: root.right-remote && !root.remote-reading && !root.busy; clicked => { root.refresh(1); } }
            Button { text: "远程设置"; enabled: !root.busy && !root.remote-reading; clicked => { root.show-settings(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            ScrollView {
                height: 42px; content-height: self.visible-height;
                HorizontalLayout {
                    spacing: 6px;
                    for tab[index] in root.tabs : HorizontalLayout {
                        spacing: 0px; horizontal-stretch: 0;
                        Button {
                            width: 220px;
                            text: (index == root.selected-tab ? "● " : "") + tab.title + (tab.attention ? " · 待认证" : (tab.busy ? " · 进行中" : ""));
                            clicked => { root.select-tab(index); }
                        }
                        Button { text: "×"; width: 32px; clicked => { root.close-tab(index); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Button { text: "+ 新连接"; clicked => { root.add-tab(); } }
        }
        Text { text: root.right-remote ? "远程模式 · 按配置链连接，完成后断开；支持文件和目录上传下载。" : "本地验证模式 · 两栏均为当前电脑目录。配置远程后可读取 Windows / Linux 目录。"; color: #526570; font-size: 13px; }
        HorizontalLayout {
            spacing: 12px;
            left-pane := FilePane {
                transfer-enabled: true;
                heading: "左侧文件"; subtitle: "当前电脑 · 本地目录"; remote: false;
                path: root.left-path; rows: root.left-rows;
                summary: root.left-summary; loading: root.left-loading;
                active: root.active-pane == 0; busy: root.busy; revision: root.revision;
                navigate(path) => { root.navigate(0, path); }
                parent-directory => { root.parent-directory(0); }
                refresh => { root.refresh(0); }
                toggle(index) => { root.toggle(0, index); }
                open(index) => { root.open(0, index); }
                select-all => { root.select-all(0); }
                clear-selection => { root.clear-selection(0); }
                activate => { root.activate(0); }
                make-payload(index, rev) => { return root.make-payload(0, index, rev); }
                accept-drop(event) => { return root.accept-drop(0, event); }
                receive-drop(event) => { root.receive-drop(0, event); }
            }
            right-pane := FilePane {
                transfer-enabled: !root.right-remote;
                heading: "右侧文件"; subtitle: root.right-remote ? (root.remote-reading ? root.remote-label + " · 正在连接读取…" : root.remote-label + " · " + root.remote-snapshot) : "当前电脑 · 用作目标端模拟";
                remote: root.right-remote;
                path: root.right-path; rows: root.right-rows;
                summary: root.right-summary; loading: root.right-loading;
                active: root.active-pane == 1; busy: root.busy; revision: root.revision;
                navigate(path) => { root.navigate(1, path); }
                parent-directory => { root.parent-directory(1); }
                refresh => { root.refresh(1); }
                toggle(index) => { root.toggle(1, index); }
                open(index) => { root.open(1, index); }
                select-all => { root.select-all(1); }
                clear-selection => { root.clear-selection(1); }
                activate => { root.activate(1); }
                make-payload(index, rev) => { return root.make-payload(1, index, rev); }
                accept-drop(event) => { return root.accept-drop(1, event); }
                receive-drop(event) => { root.receive-drop(1, event); }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Button { text: root.right-remote ? "左侧选中 → 远程" : "左侧选中 → 右侧"; enabled: !root.busy && !root.left-loading && !root.right-loading; clicked => { root.copy-selected(0); } }
            Button { text: root.right-remote ? "远程选中 → 左侧" : "左侧 ← 右侧选中"; enabled: !root.busy && !root.left-loading && !root.right-loading; clicked => { root.copy-selected(1); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: root.remote-reading ? "取消远程读取" : "取消当前批次"; enabled: root.busy || root.remote-reading; clicked => { root.cancel(); } }
        }
        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            min-height: 162px;
            max-height: 162px;
            VerticalLayout {
                padding: 12px; spacing: 6px;
                Text { text: root.status; color: #173b3d; font-weight: 600; overflow: elide; }
                ProgressIndicator { progress: root.progress; }
                Text { text: root.detail; color: #526570; font-size: 12px; overflow: elide; }
                TextEdit { text: root.history; read-only: true; font-size: 11px; }
            }
        }
    }

    if root.settings-visible : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000055;
        TouchArea { }
        Rectangle {
            x: (root.width - 820px) / 2;
            y: (root.height - self.height) / 2;
            width: 820px; height: min(700px, root.height - 32px);
            background: #ffffff;
            border-radius: 10px;
            border-width: 1px;
            border-color: #c7d4d8;
            VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Text { text: "远程连接设置"; color: #173b3d; font-size: 21px; font-weight: 700; }
                HorizontalLayout {
                    Text { text: "标签名称"; width: 76px; vertical-alignment: center; }
                    LineEdit { text <=> root.setting-tab-name; placeholder-text: "例如家里电脑、测试服务器；留空使用目标地址"; }
                }
                ScrollView {
                  content-width: self.visible-width;
                  VerticalLayout {
                    spacing: 10px;
                Text {
                    text: "保存主机、端口、用户名和默认目录。密码不会写入配置文件，实际连接时再输入。";
                    color: #526570; font-size: 12px; wrap: word-wrap;
                }
                Text { text: "中转节点（可选，按连接顺序从上到下）"; color: #178477; font-size: 14px; font-weight: 700; }
                Text { text: "按表格顺序逐级连接；没有中转节点时直连。"; font-size: 12px; }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "IP / 域名"; horizontal-stretch: 1; }
                    Text { text: "用户名"; width: 110px; }
                    Text { text: "端口"; width: 65px; }
                    Text { text: "顺序 / 删除"; width: 120px; }
                }
                ListView {
                    height: 145px;
                    for hop[index] in root.setting-hops : VerticalLayout {
                      spacing: 4px;
                      HorizontalLayout {
                        spacing: 6px;
                        LineEdit { text <=> hop.host; placeholder-text: "example.com"; horizontal-stretch: 1; }
                        LineEdit { text <=> hop.user; placeholder-text: "user"; width: 110px; }
                        LineEdit { text <=> hop.port; placeholder-text: "22"; width: 65px; }
                        Button { text: "↑"; width: 36px; enabled: index > 0; clicked => { root.change-hop(2, index); } }
                        Button { text: "↓"; width: 36px; enabled: index + 1 < root.setting-hops.length; clicked => { root.change-hop(3, index); } }
                        Button { text: "×"; width: 36px; clicked => { root.change-hop(1, index); } }
                      }
                      HorizontalLayout {
                        ComboBox { model: ["Linux", "Windows"]; current-index <=> hop.system; width: 120px; }
                        Text { text: "私钥"; vertical-alignment: center; }
                        LineEdit { text <=> hop.identity; placeholder-text: "连接发起端上的私钥路径，留空使用默认密钥 / 密码"; }
                      }
                    }
                }
                HorizontalLayout {
                    Button { text: "添加一级中转"; enabled: root.setting-hops.length < 7; clicked => { root.change-hop(0, 0); } }
                    Button { text: "清空中转（直连）"; clicked => { root.change-hop(4, 0); } }
                }
                Text { text: root.setting-windows-host == "" ? "目标 SSH 主机" : "目标 · " + root.setting-windows-host; color: #178477; font-size: 14px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "IP / 域名"; width: 76px; vertical-alignment: center; }
                    LineEdit { text <=> root.setting-windows-host; placeholder-text: "例如 100.64.0.2"; }
                    Text { text: "端口"; width: 45px; vertical-alignment: center; }
                    LineEdit { text <=> root.setting-windows-port; width: 80px; placeholder-text: "22"; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "用户名"; width: 76px; vertical-alignment: center; }
                    LineEdit { text <=> root.setting-windows-user; placeholder-text: "目标 SSH 用户"; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "默认目录"; width: 76px; vertical-alignment: center; }
                    LineEdit { text <=> root.setting-windows-root; placeholder-text: root.setting-target-system == 1 ? "例如 C:/Users/你的用户名" : "例如 /home/user"; }
                }
                HorizontalLayout {
                    Text { text: "目标系统"; width: 76px; vertical-alignment: center; }
                    ComboBox { model: ["Linux", "Windows"]; current-index <=> root.setting-target-system; width: 120px; }
                    Text { text: "私钥"; vertical-alignment: center; }
                    LineEdit { text <=> root.setting-target-identity; placeholder-text: "留空使用默认密钥 / 密码"; }
                }
                HorizontalLayout {
                    Text { text: "密码缓存"; width: 76px; vertical-alignment: center; }
                    ComboBox { model: ["5 分钟过期", "永不过期（退出程序清除）", "一次性（不缓存）"]; current-index <=> root.setting-cache-policy; }
                }
                Text {
                    text: "私钥须位于发起连接的上一台电脑，首节点使用本机私钥。Linux 需 Python 3；Windows 需 PowerShell。中断后重新选择相同源与目标即可校验续传。";
                    color: #8a5a20; font-size: 12px; wrap: word-wrap;
                }
                  }
                }
                Text { text: root.settings-error; color: #b32f2f; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "取消"; clicked => { root.cancel-settings(); } }
                    Button {
                        text: "保存设置";
                        clicked => {
                            root.save-settings(
                                root.setting-jump-host,
                                root.setting-jump-port,
                                root.setting-jump-user,
                                root.setting-windows-host,
                                root.setting-windows-port,
                                root.setting-windows-user,
                                root.setting-windows-root,
                                root.setting-route
                            );
                        }
                    }
                }
            }
        }
    }

    if root.auth-visible : Rectangle {
        width: root.width; height: root.height; background: #00000066;
        TouchArea { } // Block the underlying file panes while authenticating.
        Rectangle {
            x: (root.width - 650px) / 2; y: (root.height - 370px) / 2;
            width: 650px; height: 370px; background: #ffffff; border-radius: 10px;
            VerticalLayout {
                padding: 22px; spacing: 14px;
                Text { text: root.auth-title; font-size: 20px; font-weight: 700; color: #173b3d; }
                TextEdit { text: root.auth-detail; read-only: true; font-size: 13px; }
                if !root.auth-host-key : LineEdit {
                    text <=> root.auth-secret; input-type: password;
                    placeholder-text: "密码或私钥口令（不保存）";
                    accepted => { root.auth-submit(); }
                }
                HorizontalLayout {
                    spacing: 10px; Rectangle { horizontal-stretch: 1; }
                    Button { text: root.auth-host-key ? "拒绝并断开" : "取消"; clicked => { root.auth-cancel(); } }
                    Button { text: root.auth-host-key ? "核对后信任此主机" : "确认"; clicked => { root.auth-submit(); } }
                }
            }
        }
    }
}
